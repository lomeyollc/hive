{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hive",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],

  // Static frontend (Vite build output). The Cloudflare Vite plugin builds
  // src/frontend into dist/client automatically when you run `npm run build`.
  // not_found_handling = SPA: any route that isn't a static file or one of the
  // run_worker_first patterns below falls through to index.html for React Router.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/auth/*", "/ws/*"]
  },

  // One BoardDO instance per board (DO id = board slug). SQLite storage backend
  // is required here (new_sqlite_classes) — it's what keeps this on the free
  // plan and gives each DO its own durable sql.exec() storage.
  "durable_objects": {
    "bindings": [{ "name": "BOARD_DO", "class_name": "BoardDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardDO"] }],

  // D1 is a denormalized READ-ONLY index for cross-board search/dashboard only.
  // Each BoardDO's own SQLite storage is the source of truth for its tasks.
  // database_id below is a placeholder — replace it after running:
  //   wrangler d1 create hive
  // (see README.md "Self-host quickstart" for the full sequence).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hive",
      "database_id": "9297e55f-4668-4df6-a0e0-9be3bd0eb097",
      "migrations_dir": "./migrations"
    }
  ],

  "observability": { "enabled": true },

  // Daily "what's still stuck" Telegram digest — see scheduled() in
  // src/worker/index.ts. 15:00 UTC ≈ 9 PM Bangladesh time; change freely,
  // it's just cron syntax. No-ops harmlessly if Telegram isn't configured.
  "triggers": { "crons": ["0 15 * * *"] },

  // Not sensitive — the base URL this instance is reachable at, used to
  // build links in Telegram messages. Safe to keep in vars (not a secret).
  "vars": { "APP_URL": "https://hive.lomeyo.com" }

  // Secrets (never committed, never put in "vars" here — set with `wrangler secret put <NAME>`):
  //   GOOGLE_CLIENT_ID      - Google OAuth 2.0 client ID (Google Cloud Console)
  //   GOOGLE_CLIENT_SECRET  - Google OAuth 2.0 client secret
  //   SESSION_SECRET        - random string used to HMAC-sign the session cookie
  //   TELEGRAM_BOT_TOKEN    - from @BotFather, optional (no notifications until set)
  //   TELEGRAM_CHAT_ID      - your chat id, optional
  // See .dev.vars.example for local development.
}
