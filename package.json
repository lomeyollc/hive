{
  "name": "hive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source, AI-agent-native task board. One human, one fleet of agents, one live board.",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "check": "tsc -b --noEmit",
