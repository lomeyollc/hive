# Copy to .dev.vars for local development (`wrangler dev` reads this file).
# In production, set these with `wrangler secret put <NAME>` — never commit
# real values, and never put them in wrangler.jsonc.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# Optional. Comma-separated emails allowed to sign in. Unset = any
# Google-verified email is trusted (fine for a private instance whose URL
# you don't share; set this for a public-facing one).
ALLOWED_EMAILS=

# Optional. Powers the needs-human escalation ping + daily digest (see
# README "Escalation: needs_human"). Unset = notifications are silently
# skipped, everything else still works.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
